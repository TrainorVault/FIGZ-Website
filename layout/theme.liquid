<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-money-format="{{ shop.money_format | strip_html | escape }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.color_bg }}">

  {%- if settings.fb_domain_verification != blank -%}
    <meta name="facebook-domain-verification" content="{{ settings.fb_domain_verification | escape }}">
  {%- endif -%}

  {%- comment -%} SEO title & description {%- endcomment -%}
  <title>
    {{- page_title -}}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%} Open Graph / social {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="{{ page_image.width }}">
    <meta property="og:image:height" content="{{ page_image.height }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  {%- if settings.favicon -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- comment -%} Fonts: Archivo (display) + Barlow (body) — loaded non-render-blocking {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- assign fonts_href = "https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800;900&family=Barlow:wght@400;500;600&display=swap" -%}
  <link rel="preload" as="style" href="{{ fonts_href }}">
  <link rel="stylesheet" href="{{ fonts_href }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ fonts_href }}"></noscript>

  {%- comment -%} Design tokens from theme settings {%- endcomment -%}
  <style>
    :root {
      --c-bg: {{ settings.color_bg }};
      --c-surface: {{ settings.color_surface }};
      --c-surface-2: {{ settings.color_surface_2 }};
      --c-text: {{ settings.color_text }};
      --c-muted: {{ settings.color_muted }};
      --c-accent: {{ settings.color_accent }};
      --c-accent-text: {{ settings.color_accent_text }};
      --c-live: {{ settings.color_live }};
      --c-border: {{ settings.color_text | color_modify: 'alpha', 0.10 }};
      --font-display: 'Archivo', system-ui, sans-serif;
      --font-body: 'Barlow', system-ui, sans-serif;
    }
  </style>

  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'global.js' | asset_url }}" defer></script>

  {%- comment -%} Organization structured data {%- endcomment -%}
  {%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: '/' | json }}
      {%- if settings.logo %},
      "logo": {{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }}
      {%- endif %}
      {%- assign socials = '' -%}
      {%- if settings.social_instagram != blank %}{% assign socials = socials | append: settings.social_instagram | append: ',' %}{% endif -%}
      {%- if settings.social_tiktok != blank %}{% assign socials = socials | append: settings.social_tiktok | append: ',' %}{% endif -%}
      {%- if settings.social_youtube != blank %}{% assign socials = socials | append: settings.social_youtube | append: ',' %}{% endif -%}
      {%- if socials != blank %},
      "sameAs": {{ socials | split: ',' | json }}
      {%- endif %}
    }
  </script>
  {%- endif -%}

  {%- comment -%} Google Analytics 4 (also feeds Google Ads conversions) {%- endcomment -%}
  {%- if settings.ga4_id != blank -%}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.ga4_id }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', {{ settings.ga4_id | json }});
    </script>
  {%- endif -%}

  {%- comment -%} Loox reviews — head {%- endcomment -%}
  {%- if settings.enable_loox -%}
    {{ shop.metafields.loox["global_html_head"] }}
  {%- endif -%}

  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handle }}">
  <a class="skip-link" href="#MainContent">Skip to content</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'currency-floater' %}
  {% render 'language-prompt' %}

  {%- comment -%} Loox reviews — body {%- endcomment -%}
  {%- if settings.enable_loox -%}
    {{ shop.metafields.loox["global_html_body"] }}
  {%- endif -%}

  {%- comment -%} Klaviyo onsite — forms, popups, abandoned cart {%- endcomment -%}
  {%- if settings.klaviyo_company_id != blank -%}
    <script async type="text/javascript" src="//static.klaviyo.com/onsite/js/klaviyo.js?company_id={{ settings.klaviyo_company_id }}"></script>
    <script>
      var _learnq = _learnq || [];
      {%- if customer.email != blank -%}
        _learnq.push(['identify', { '$email': {{ customer.email | json }} }]);
      {%- endif -%}
    </script>
  {%- endif -%}
</body>
</html>
