<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;900&family=Barlow:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --c-bg: {{ settings.color_bg | default: '#050506' }};
      --c-text: {{ settings.color_text | default: '#E8E8EE' }};
      --c-muted: {{ settings.color_muted | default: '#9A9AA2' }};
      --c-accent: {{ settings.color_accent | default: '#F5C518' }};
      --c-accent-text: {{ settings.color_accent_text | default: '#0A0A0B' }};
    }
    * { box-sizing: border-box; margin: 0; }
    body {
      min-height: 100svh; display: grid; place-items: center;
      background: var(--c-bg); color: var(--c-text);
      font-family: 'Barlow', system-ui, sans-serif; text-align: center; padding: 24px;
    }
    h1 { font-family: 'Archivo', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: 0.04em; font-size: clamp(2rem, 6vw, 3.5rem); }
    p { color: var(--c-muted); margin: 16px 0 32px; }
    form { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
    input[type="password"] {
      background: #101015; border: 1px solid rgba(232,232,238,0.14); color: var(--c-text);
      padding: 14px 16px; border-radius: 8px; min-width: 240px; font: inherit;
    }
    button {
      background: var(--c-accent); color: var(--c-accent-text); border: 0; border-radius: 8px;
      padding: 14px 24px; font-family: 'Archivo', sans-serif; font-weight: 800; text-transform: uppercase;
      letter-spacing: 0.06em; cursor: pointer;
    }
  </style>
  {{ content_for_header }}
</head>
<body>
  <div>
    {{ content_for_layout }}
  </div>
</body>
</html>
