[
  {
    "name": "theme_info",
    "theme_name": "FIGZ Collect",
    "theme_version": "1.0.0",
    "theme_author": "FIGZ Collection",
    "theme_documentation_url": "https://github.com/TrainorVault/FIGZ-Website",
    "theme_support_url": "https://www.figzcollection.com/pages/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Will be scaled to 32 x 32px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#050506"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (cards, drawers)",
        "default": "#101015"
      },
      {
        "type": "color",
        "id": "color_surface_2",
        "label": "Surface raised",
        "default": "#15151B"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#E8E8EE"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#9A9AA2"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (brand blue)",
        "default": "#1CA7E5"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Text on accent",
        "default": "#04141C"
      },
      {
        "type": "color",
        "id": "color_live",
        "label": "Live / urgency",
        "default": "#FF3B3B"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_free_shipping_bar",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold — Australia (AUD)",
        "info": "Keep in sync with your AU free-shipping discount ($150).",
        "default": 150
      },
      {
        "type": "number",
        "id": "free_shipping_threshold_intl",
        "label": "Free shipping threshold — International (AUD)",
        "info": "Keep in sync with your international free-shipping discount ($250).",
        "default": 250
      },
      {
        "type": "text",
        "id": "fx_rates_from_aud",
        "label": "Approximate currency rates (from AUD)",
        "info": "Used only to show shipping costs and the free-shipping threshold in the buyer's currency — checkout is always authoritative. Format: USD:0.66, EUR:0.61. A currency left out shows the AUD figure instead. Refresh these occasionally.",
        "default": "USD:0.66, EUR:0.61, GBP:0.52, NZD:1.09, CAD:0.90, SGD:0.85, JPY:98, CHF:0.55, HKD:5.10, SEK:6.30, NOK:6.80, DKK:4.55, PLN:2.60, CZK:15.30, MXN:12.50, BRL:3.60, AED:2.42, INR:55.00, CNY:4.70, ZAR:12.00"
      },
      {
        "type": "product",
        "id": "cart_upsell_product",
        "label": "Cart upsell product",
        "info": "A low-price impulse add shown in the cart drawer (e.g. a collectible sticker)."
      },
      {
        "type": "header",
        "content": "Checkout reservation timer"
      },
      {
        "type": "checkbox",
        "id": "show_checkout_timer",
        "label": "Show 'items reserved' countdown in cart",
        "default": true,
        "info": "Urgency timer shown in the cart drawer and cart page. Loops when it reaches zero — the cart is never cleared."
      },
      {
        "type": "range",
        "id": "checkout_timer_minutes",
        "min": 3,
        "max": 30,
        "step": 1,
        "unit": "min",
        "label": "Timer length",
        "default": 10
      },
      {
        "type": "text",
        "id": "checkout_timer_text",
        "label": "Timer text",
        "default": "Your items are reserved for"
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "number",
        "id": "low_stock_threshold",
        "label": "Low stock badge threshold",
        "info": "Show LOW STOCK badge when total inventory falls below this number.",
        "default": 25
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook URL"
      }
    ]
  },
  {
    "name": "Analytics & integrations",
    "settings": [
      {
        "type": "paragraph",
        "content": "Install the Meta and TikTok pixels via their official Shopify apps so server-side (Conversions API) events are included. The fields below restore the tracking and review integrations from your previous theme."
      },
      {
        "type": "header",
        "content": "Google Analytics (GA4)"
      },
      {
        "type": "text",
        "id": "ga4_id",
        "label": "GA4 Measurement ID",
        "info": "e.g. G-XXXXXXXXXX. Leave blank to disable. Also powers Google Ads conversion import.",
        "default": "G-J54LNR2Q06"
      },
      {
        "type": "header",
        "content": "Meta / Facebook"
      },
      {
        "type": "text",
        "id": "fb_domain_verification",
        "label": "Facebook domain verification code",
        "info": "The content value from your facebook-domain-verification meta tag (Business Manager → Brand Safety → Domains).",
        "default": "diu0iou87awmsuqe9p6s9zc2a1hsrw"
      },
      {
        "type": "header",
        "content": "Klaviyo"
      },
      {
        "type": "text",
        "id": "klaviyo_company_id",
        "label": "Klaviyo public API key (company ID)",
        "info": "Loads Klaviyo onsite JS for forms, popups and abandoned-cart. Leave blank to disable.",
        "default": "KJiVvV"
      },
      {
        "type": "header",
        "content": "Loox reviews"
      },
      {
        "type": "checkbox",
        "id": "enable_loox",
        "label": "Show Loox reviews",
        "info": "Injects the Loox widget scripts (star ratings and review carousels). Requires the Loox app installed.",
        "default": true
      }
    ]
  }
]
