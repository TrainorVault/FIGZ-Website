[
  {
    "name": "theme_info",
    "theme_name": "FIGZ Collect",
    "theme_version": "1.0.0",
    "theme_author": "FIGZ Collection",
    "theme_documentation_url": "https://github.com/TrainorVault/FIGZ-Website",
    "theme_support_url": "https://www.figzcollection.com/pages/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Will be scaled to 32 x 32px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#050506"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (cards, drawers)",
        "default": "#101015"
      },
      {
        "type": "color",
        "id": "color_surface_2",
        "label": "Surface raised",
        "default": "#15151B"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#E8E8EE"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#9A9AA2"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (brand blue)",
        "default": "#1CA7E5"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Text on accent",
        "default": "#04141C"
      },
      {
        "type": "color",
        "id": "color_live",
        "label": "Live / urgency",
        "default": "#FF3B3B"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_free_shipping_bar",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold — Australia",
        "info": "Shown in the cart bar for AU customers. Keep in sync with your AU free-shipping discount ($125).",
        "default": 125
      },
      {
        "type": "number",
        "id": "free_shipping_threshold_intl",
        "label": "Free shipping threshold — International",
        "info": "Shown in the cart bar for non-AU customers. Keep in sync with your international free-shipping discount ($250).",
        "default": 250
      },
      {
        "type": "product",
        "id": "cart_upsell_product",
        "label": "Cart upsell product",
        "info": "A low-price impulse add shown in the cart drawer (e.g. a collectible sticker)."
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "number",
        "id": "low_stock_threshold",
        "label": "Low stock badge threshold",
        "info": "Show LOW STOCK badge when total inventory falls below this number.",
        "default": 25
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook URL"
      }
    ]
  },
  {
    "name": "Analytics",
    "settings": [
      {
        "type": "paragraph",
        "content": "Install Meta, Google and TikTok pixels via their official Shopify apps (server-side events included). Avoid pasting raw pixel scripts here."
      }
    ]
  }
]
