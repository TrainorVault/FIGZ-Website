<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        {%- if section.settings.overline != blank -%}
          <span class="overline">{{ section.settings.overline }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.blog != blank -%}
        <a class="link-arrow" href="{{ section.settings.blog.url }}">All stories</a>
      {%- endif -%}
    </div>
    <div class="editorial-grid">
      {%- if section.settings.blog != blank -%}
        {%- for article in section.settings.blog.articles limit: section.settings.limit -%}
          <article class="editorial-card reveal">
            <div class="editorial-card__media">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 700 }}"
                  srcset="{{ article.image | image_url: width: 500 }} 500w, {{ article.image | image_url: width: 800 }} 800w"
                  sizes="(min-width: 750px) 33vw, 100vw"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
            <p class="editorial-card__date">{{ article.published_at | date: '%d %b %Y' }}</p>
            <h3 class="editorial-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
          </article>
        {%- endfor -%}
      {%- else -%}
        <p class="text-muted">Select a blog in the section settings.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial",
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline", "default": "Collect Culture™" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Behind the Drops" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "min": 2, "max": 6, "step": 1, "label": "Articles to show", "default": 3 }
  ],
  "presets": [{ "name": "Editorial" }]
}
{% endschema %}
