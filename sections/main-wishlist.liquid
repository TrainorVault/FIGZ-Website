{%- comment -%}
  Wishlist page. Renders saved items from localStorage (guest-friendly),
  populated by global.js. Server output is just the shell + empty state.
{%- endcomment -%}
<div class="container wishlist-page" data-wishlist-page>
  <header class="wishlist-page__head">
    <h1 class="h2">{{ section.settings.heading | default: 'My Collection' }}</h1>
    <p class="text-muted" data-wishlist-sub>{{ section.settings.subtext | default: 'Everything you’ve saved, kept in one place.' }}</p>
  </header>

  <div class="wishlist-page__grid product-grid" data-wishlist-grid hidden></div>

  <div class="wishlist-page__empty empty-state" data-wishlist-empty>
    <p>{{ section.settings.empty_text | default: 'Your collection is empty. Tap the heart on any piece to save it here.' }}</p>
    <a class="btn btn--primary" href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}">{{ section.settings.empty_link_label | default: 'Explore the Collection' }}</a>
  </div>
</div>

{% schema %}
{
  "name": "Wishlist page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "My Collection" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Everything you’ve saved, kept in one place." },
    { "type": "text", "id": "empty_text", "label": "Empty message", "default": "Your collection is empty. Tap the heart on any piece to save it here." },
    { "type": "url", "id": "empty_link", "label": "Empty state button link" },
    { "type": "text", "id": "empty_link_label", "label": "Empty state button label", "default": "Explore the Collection" }
  ],
  "presets": [{ "name": "Wishlist page" }]
}
{% endschema %}
