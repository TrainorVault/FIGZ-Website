<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        {%- if section.settings.overline != blank -%}
          <span class="overline">{{ section.settings.overline }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a class="link-arrow" href="{{ section.settings.collection.url }}">View all</a>
      {%- endif -%}
    </div>
    <div class="product-grid{% if section.settings.columns == '3' %} product-grid--3{% endif %}">
      {%- assign limit = section.settings.limit -%}
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="product-card">
            <div class="product-card__media"></div>
            <div class="product-card__info">
              <h3 class="product-card__title">Example product</h3>
              <p class="product-card__price">$50.00</p>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline", "default": "The Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the Drop" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "select", "id": "columns", "label": "Desktop columns", "options": [
      { "value": "3", "label": "3" },
      { "value": "4", "label": "4" }
    ], "default": "4" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
