{%- comment -%}
  "Complete the collection" — curated cross-sells.
  Uses product metafield figz.companions (list of products) when set.
  Otherwise fetches Shopify product recommendations client-side via the
  Section Rendering API (recommendations.* is only populated on that
  endpoint render, not on the initial page render).
{%- endcomment -%}
{%- assign companions = product.metafields.figz.companions.value -%}
{%- if companions != blank -%}
  <section class="section" style="border-top: 1px solid var(--c-border);">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="overline">{{ section.settings.overline }}</span>
          <h2>{{ section.settings.heading }}</h2>
        </div>
      </div>
      <div class="product-grid">
        {%- for companion in companions limit: 4 -%}
          {% render 'product-card', product: companion %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- else -%}
  <div
    data-recommendations
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4"
  >
    {%- if recommendations.performed and recommendations.products.size > 0 -%}
      <section class="section" style="border-top: 1px solid var(--c-border);">
        <div class="container">
          <div class="section-head reveal">
            <div>
              <span class="overline">{{ section.settings.overline }}</span>
              <h2>{{ section.settings.heading }}</h2>
            </div>
          </div>
          <div class="product-grid">
            {%- for rec in recommendations.products limit: 4 -%}
              {% render 'product-card', product: rec %}
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Complete the collection",
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline", "default": "Don't stop at one" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the Collection" },
    { "type": "paragraph", "content": "Curate pairings per product with the figz.companions metafield (product list). Falls back to automatic Shopify recommendations." }
  ]
}
{% endschema %}
