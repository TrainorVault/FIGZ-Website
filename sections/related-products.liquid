{%- comment -%}
  Recommended products — a sideways-scrolling rail of the top products
  in this product's collection. Uses the section's chosen collection if set,
  otherwise the first real collection the product belongs to.
{%- endcomment -%}
{%- liquid
  assign rec_collection = section.settings.collection

  if rec_collection == blank
    for c in product.collections
      unless c.handle == 'all' or c.handle == 'frontpage'
        assign rec_collection = c
        break
      endunless
    endfor
  endif

  assign limit = section.settings.limit | default: 5
-%}

{%- if rec_collection != blank and rec_collection.products.size > 1 -%}
  <section class="section" style="border-top: 1px solid var(--c-border);">
    <div class="container">
      <div class="section-head reveal">
        <div>
          {%- if section.settings.overline != blank -%}
            <span class="overline">{{ section.settings.overline }}</span>
          {%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>
        <a class="link-arrow" href="{{ rec_collection.url }}">View all</a>
      </div>

      <div class="rail rail--products">
        {%- assign shown = 0 -%}
        {%- for p in rec_collection.products limit: 12 -%}
          {%- if p.id != product.id and shown < limit -%}
            {% render 'product-card', product: p %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Recommended products",
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline", "default": "Don't stop at one" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the Collection" },
    { "type": "range", "id": "limit", "min": 3, "max": 10, "step": 1, "label": "Products to show", "default": 5 },
    { "type": "collection", "id": "collection", "label": "Collection (optional)", "info": "Leave empty to use the collection this product belongs to." }
  ]
}
{% endschema %}
