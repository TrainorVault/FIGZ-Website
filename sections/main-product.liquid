{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign edition_size = product.metafields.figz.edition_size.value
  assign signed_count = product.metafields.figz.signed_count.value
  assign ship_note = product.metafields.figz.ship_note.value
  assign drop_label = product.metafields.figz.drop_label.value

  assign total_inv = 0
  assign tracked = false
  for variant in product.variants
    if variant.inventory_management != blank
      assign tracked = true
      assign total_inv = total_inv | plus: variant.inventory_quantity
    endif
  endfor

  assign is_preorder = product.metafields.figz.preorder.value

  assign atc_label = 'Add to Cart'
  if section.settings.preorder_label != blank and is_preorder
    assign atc_label = section.settings.preorder_label
  endif

  # ---------- Bundle offer: products, discounts, totals ----------
  assign bundle_on = product.metafields.figz.bundle_enabled.value
  assign bp1 = product.metafields.figz.bundle_product.value
  assign bd1 = product.metafields.figz.bundle_discount.value | default: 0
  assign bp2 = product.metafields.figz.bundle_product_2.value
  assign bd2 = product.metafields.figz.bundle_discount_2.value | default: 0
  assign bp3 = product.metafields.figz.bundle_product_3.value
  assign bd3 = product.metafields.figz.bundle_discount_3.value | default: 0

  assign has_addon = false
  assign bundle_now = current_variant.price
  assign bundle_was = current_variant.price
  assign bundle_save_cents = 0

  for entry in (1..3)
    case entry
      when 1
        assign ap = bp1
        assign apd = bd1
      when 2
        assign ap = bp2
        assign apd = bd2
      when 3
        assign ap = bp3
        assign apd = bd3
    endcase
    if ap != blank and ap.available
      assign has_addon = true
      assign av = ap.selected_or_first_available_variant
      assign off_cents = apd | times: 100
      assign newp = av.price | minus: off_cents
      if newp < 0
        assign newp = 0
      endif
      assign bundle_was = bundle_was | plus: av.price
      assign bundle_now = bundle_now | plus: newp
      assign bundle_save_cents = bundle_save_cents | plus: off_cents
    endif
  endfor

  assign bundle_show = false
  if bundle_on and has_addon and product.available
    assign bundle_show = true
  endif

  assign bundle_atc_label = section.settings.bundle_atc_label | default: 'Add Bundle to Cart'
  assign init_atc = atc_label
  if bundle_show and section.settings.bundle_default_selected
    assign init_atc = bundle_atc_label
  endif
-%}

<div class="container">
  <div class="product-layout">
    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="product-layout__gallery">
      <div class="gallery__main" data-gallery-track>
        {%- for media in product.media -%}
          <div class="gallery__slide">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <img
                  src="{{ media | image_url: width: 1000 }}"
                  srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1500 }} 1500w"
                  sizes="(min-width: 990px) 58vw, 100vw"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                  {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                >
              {%- when 'video' -%}
                {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="gallery__thumbs">
          {%- for media in product.media -%}
            <button class="gallery__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-gallery-thumb="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
              <img src="{{ media | image_url: width: 128 }}" alt="" width="64" height="64" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Buy box ---------- {%- endcomment -%}
    <div class="buy-box">
      {%- if drop_label != blank -%}
        <span class="overline">{{ drop_label }}</span>
      {%- endif -%}
      <h1 class="buy-box__title">{{ product.title }}</h1>
      <p class="buy-box__price" data-price>{{ current_variant.price | money }}</p>
      {%- if section.settings.show_installments -%}
        <p class="buy-box__installments">or 4 interest-free payments of {{ current_variant.price | divided_by: 4 | money }} with Afterpay</p>
      {%- endif -%}

      {%- comment -%} Edition highlights — editable blocks in the theme editor (Product page section) {%- endcomment -%}
      {%- assign edition_rows = section.blocks | where: 'type', 'edition_highlight' -%}
      {%- if edition_size != blank and edition_rows.size > 0 -%}
        <div class="edition-block">
          {%- for block in edition_rows -%}
            <div class="edition-block__row" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon %}{%- endif -%}
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
          {%- if tracked and total_inv > 0 -%}
            {%- assign pct = total_inv | times: 100 | divided_by: edition_size -%}
            {%- if pct <= 25 -%}
              <div class="edition-block__remaining">
                <p class="edition-block__remaining-label">Only {{ total_inv }} remaining</p>
                <div class="shipping-bar__track"><div class="shipping-bar__fill" style="width: {{ pct }}%;"></div></div>
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} ---------- Product form ---------- {%- endcomment -%}
      {%- assign product_form_id = 'product-form-' | append: section.id -%}
      {%- form 'product', product, id: product_form_id, data-product-form: '', data-main: '' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          <div data-variant-picker="ProductJson-{{ section.id }}">
            {%- for option in product.options_with_values -%}
              <fieldset class="option-group">
                <legend class="option-group__label">
                  {{ option.name }}
                  {%- if option.name == 'Size' and section.settings.size_guide != blank -%}
                    <a href="{{ section.settings.size_guide.url }}">Size guide</a>
                  {%- endif -%}
                </legend>
                <div class="option-pills">
                  {%- for value in option.values -%}
                    <span class="option-pill">
                      <input
                        type="radio"
                        id="opt-{{ option.position }}-{{ forloop.index }}"
                        name="option-{{ option.position }}"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >
                      <label for="opt-{{ option.position }}-{{ forloop.index }}">{{ value }}</label>
                    </span>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- comment -%} ---------- Bundle offer (above Add to Cart, one button) ---------- {%- endcomment -%}
        {%- if bundle_show -%}
          {%- capture add_json -%}[{"id":{{ current_variant.id }},"quantity":1}{% if bp1 != blank and bp1.available %},{"id":{{ bp1.selected_or_first_available_variant.id }},"quantity":1}{% endif %}{% if bp2 != blank and bp2.available %},{"id":{{ bp2.selected_or_first_available_variant.id }},"quantity":1}{% endif %}{% if bp3 != blank and bp3.available %},{"id":{{ bp3.selected_or_first_available_variant.id }},"quantity":1}{% endif %}]{%- endcapture -%}
          <div class="bundle" data-bundle data-bundle-items='{{ add_json }}'>
            <div class="bundle-divider"><span>{{ product.metafields.figz.bundle_heading | default: 'Complete the Set' }}</span></div>

            {%- if section.settings.bundle_timer_minutes > 0 -%}
              <p class="bundle-timer" data-bundle-timer data-duration="{{ section.settings.bundle_timer_minutes | times: 60 }}" data-key="{{ product.id }}">
                {{ section.settings.bundle_timer_text | default: 'Hurry! Offer expires in' }} <span data-bundle-timer-out>{{ section.settings.bundle_timer_minutes }}:00</span> ⏰
              </p>
            {%- endif -%}

            <label class="bundle-select{% if section.settings.bundle_default_selected %} is-selected{% endif %}" data-bundle-select>
              <input class="bundle-select__input" type="checkbox" data-bundle-toggle {% if section.settings.bundle_default_selected %}checked{% endif %} aria-label="{{ section.settings.bundle_select_label | default: 'Complete the bundle' }}">
              <span class="bundle-select__mark" aria-hidden="true"></span>
              <span class="bundle-select__text">
                <strong class="bundle-select__title">{{ section.settings.bundle_select_label | default: 'Complete the bundle' }}</strong>
                {%- if bundle_save_cents > 0 -%}<span class="bundle-select__save">Save {{ bundle_save_cents | money }}!</span>{%- endif -%}
              </span>
              <span class="bundle-select__price">
                <span class="bundle-select__now">{{ bundle_now | money }}</span>
                {%- if bundle_was > bundle_now -%}<s class="bundle-select__was">{{ bundle_was | money }}</s>{%- endif -%}
              </span>
            </label>

            <div class="bundle__addons">
              <div class="bundle__item">
                {%- if product.featured_media -%}
                  <img src="{{ product.featured_media | image_url: width: 160 }}" alt="{{ product.title | escape }}" width="80" height="80" loading="lazy">
                {%- endif -%}
                <div class="bundle__item-info">
                  <p class="bundle__item-title">{{ product.title }}</p>
                  <p class="bundle__item-price">{{ current_variant.price | money }}</p>
                </div>
              </div>

              {%- for entry in (1..3) -%}
                {%- liquid
                  case entry
                    when 1
                      assign ap = bp1
                      assign apd = bd1
                    when 2
                      assign ap = bp2
                      assign apd = bd2
                    when 3
                      assign ap = bp3
                      assign apd = bd3
                  endcase
                -%}
                {%- if ap != blank and ap.available -%}
                  {%- liquid
                    assign av = ap.selected_or_first_available_variant
                    assign off_cents = apd | times: 100
                    assign newp = av.price | minus: off_cents
                    if newp < 0
                      assign newp = 0
                    endif
                  -%}
                  <div class="bundle__item bundle__item--addon">
                    <span class="bundle__plus" aria-hidden="true">+</span>
                    <a href="{{ ap.url }}">
                      {%- if ap.featured_media -%}
                        <img src="{{ ap.featured_media | image_url: width: 160 }}" alt="{{ ap.title | escape }}" width="80" height="80" loading="lazy">
                      {%- endif -%}
                    </a>
                    <div class="bundle__item-info">
                      <p class="bundle__item-title"><a href="{{ ap.url }}">{{ ap.title }}</a></p>
                      <p class="bundle__item-price">
                        {%- if apd > 0 -%}
                          <span class="price--sale">{{ newp | money }}</span>
                          <s class="price--compare">{{ av.price | money }}</s>
                          <span class="bundle__save">Save {{ off_cents | money }}</span>
                        {%- else -%}
                          {{ av.price | money }}
                        {%- endif -%}
                      </p>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <div class="buy-box__actions" data-buy-actions>
          <div class="buy-row">
            <div class="qty qty--pdp" aria-label="Quantity">
              <button class="qty__btn" type="button" data-qty-adjust="-1" aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
              <button class="qty__btn" type="button" data-qty-adjust="1" aria-label="Increase quantity">+</button>
            </div>
            <button
              class="btn btn--primary buy-row__atc"
              type="submit"
              data-atc-text="{{ atc_label }}"
              data-atc-bundle-text="{{ bundle_atc_label }}"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}{{ init_atc }}{%- else -%}Sold Out{%- endif -%}
            </button>
          </div>
          {%- if section.settings.show_dynamic_checkout -%}
            <div data-dynamic-checkout{% if bundle_show and section.settings.bundle_default_selected %} hidden{% endif %}>{{ form | payment_button }}</div>
          {%- endif -%}
        </div>
      {%- endform -%}

      {%- comment -%} Back-in-stock capture on sold-out {%- endcomment -%}
      {%- unless product.available -%}
        <div class="notify-form">
          <p>Sold out — but volumes come back around. Get notified about restocks and the next drop:</p>
          {%- form 'customer' -%}
            {%- if form.posted_successfully? -%}
              <p class="newsletter__success">You'll be first to know.</p>
            {%- else -%}
              <input type="hidden" name="contact[tags]" value="back-in-stock,{{ product.handle }}">
              <div class="newsletter__form">
                <input type="email" name="contact[email]" placeholder="Email address" required aria-label="Email address">
                <button class="btn btn--ghost" type="submit">Notify Me</button>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endunless -%}

      {%- comment -%} Trust row {%- endcomment -%}
      <div class="trust-row">
        <div class="trust-row__item">{% render 'icon', name: 'shield' %} Authenticity guaranteed</div>
        <div class="trust-row__item">{% render 'icon', name: 'truck' %} Tracked shipping worldwide</div>
        <div class="trust-row__item">{% render 'icon', name: 'star' %} Collect Culture</div>
      </div>

      {%- comment -%} Description + accordions. Theme-editor override wins for the drop product; otherwise the product's own description shows. {%- endcomment -%}
      {%- liquid
        assign desc_body = product.description
        if edition_size != blank and section.settings.drop_description != blank
          assign desc_body = section.settings.drop_description
        endif
      -%}
      {%- if desc_body != blank -%}
        <details open>
          <summary>Description</summary>
          <div class="details-body rte">{{ desc_body }}</div>
        </details>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'accordion' -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="details-body rte">{{ block.settings.content }}</div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ---------- Story blocks (image + copy, alternating) ---------- {%- endcomment -%}
  {%- assign story_blocks = section.blocks | where: 'type', 'story' -%}
  {%- if story_blocks.size > 0 -%}
    <div class="product-story">
      {%- for block in story_blocks -%}
        <div class="product-story__block reveal" {{ block.shopify_attributes }}>
          <div class="product-story__media">
            {%- if block.settings.image -%}
              <img
                src="{{ block.settings.image | image_url: width: 900 }}"
                alt="{{ block.settings.heading | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {%- endif -%}
          </div>
          <div class="product-story__copy">
            {%- if block.settings.overline != blank -%}
              <span class="overline">{{ block.settings.overline }}</span>
            {%- endif -%}
            <h2 class="h2">{{ block.settings.heading }}</h2>
            <p class="text-muted">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{%- comment -%} ---------- Sticky add-to-cart ---------- {%- endcomment -%}
<div class="sticky-atc" data-sticky-atc>
  <div class="sticky-atc__inner">
    {%- if product.featured_media -%}
      <img class="sticky-atc__img" src="{{ product.featured_media | image_url: width: 88 }}" alt="" width="44" height="44" loading="lazy">
    {%- endif -%}
    <div class="sticky-atc__info">
      <p class="sticky-atc__title">{{ product.title }}</p>
      <p class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</p>
    </div>
    <button
      class="btn btn--primary"
      type="submit"
      form="product-form-{{ section.id }}"
      data-atc-text="{{ atc_label }}"
      data-atc-bundle-text="{{ bundle_atc_label }}"
      {% unless current_variant.available %}disabled{% endunless %}
    >
      {%- if current_variant.available -%}{{ init_atc }}{%- else -%}Sold Out{%- endif -%}
    </button>
  </div>
</div>

{%- comment -%} Variant data for JS picker {%- endcomment -%}
<script type="application/json" id="ProductJson-{{ section.id }}">
  {{ product.variants | json }}
</script>

{%- comment -%} Product structured data {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media %}
    "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif %}
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    {%- if current_variant.sku != blank %}
    "sku": {{ current_variant.sku | json }},
    {%- endif %}
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ current_variant.price | divided_by: 100.0 | json }},
      "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ request.origin | append: product.url | json }}
    }
  }
</script>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button (Shop Pay etc.)", "default": true },
    { "type": "checkbox", "id": "show_installments", "label": "Show Afterpay instalments line", "default": true },
    { "type": "text", "id": "preorder_label", "label": "Button label for pre-orders", "default": "Pre-Order", "info": "Used when a product's figz.preorder metafield is turned ON." },
    { "type": "header", "content": "Bundle offer" },
    { "type": "text", "id": "bundle_select_label", "label": "Bundle option label", "default": "Complete the bundle" },
    { "type": "text", "id": "bundle_atc_label", "label": "Add-to-cart label when bundle is selected", "default": "Add Bundle to Cart" },
    { "type": "checkbox", "id": "bundle_default_selected", "label": "Pre-select the bundle", "default": false, "info": "Turn on to have the bundle selected by default (raises AOV, but less transparent)." },
    { "type": "range", "id": "bundle_timer_minutes", "min": 0, "max": 30, "step": 1, "unit": "min", "label": "Urgency timer length", "default": 15, "info": "Countdown shown above the bundle. Set to 0 to hide it." },
    { "type": "text", "id": "bundle_timer_text", "label": "Timer text", "default": "Hurry! Offer expires in" },
    { "type": "page", "id": "size_guide", "label": "Size guide page" },
    { "type": "header", "content": "Drop product — description" },
    { "type": "richtext", "id": "drop_description", "label": "Description (overrides the product's own description)", "info": "For the featured drop product only. Leave empty to use the description set in the product admin." },
    { "type": "paragraph", "content": "The edition box shows the 'Edition highlight' blocks below (only on the featured drop product). Edit their icon and text there." }
  ],
  "blocks": [
    {
      "type": "edition_highlight",
      "name": "Edition highlight",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "star", "options": [
          { "value": "star", "label": "Star" },
          { "value": "rocket", "label": "Rocket" },
          { "value": "box", "label": "Box" },
          { "value": "medal", "label": "Medal" },
          { "value": "truck", "label": "Truck" },
          { "value": "shield", "label": "Shield" },
          { "value": "globe", "label": "Globe" },
          { "value": "none", "label": "No icon" }
        ] },
        { "type": "text", "id": "text", "label": "Text", "default": "First 150 Hand Signed" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & Returns" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Tracked shipping worldwide. 30-day returns on unopened items.</p>" }
      ]
    },
    {
      "type": "story",
      "name": "Story block",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "overline", "label": "Overline", "default": "The Story" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Made for collectors" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ]
}
{% endschema %}
