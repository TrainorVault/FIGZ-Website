<div class="container section">
  <div class="cart-page">
    <h1 style="margin-bottom: 24px;">Your Cart</h1>
    {%- if cart.item_count == 0 -%}
      <div class="empty-state">
        <p>Your cart is empty.</p>
        <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">Shop the Collection</a>
      </div>
    {%- else -%}
      {%- if settings.show_checkout_timer -%}
        <div class="cart-timer cart-timer--page" data-cart-timer data-duration="{{ settings.checkout_timer_minutes | default: 10 | times: 60 }}">
          <span class="cart-timer__icon" aria-hidden="true">⏳</span>
          <span class="cart-timer__text">{{ settings.checkout_timer_text | default: 'Your items are reserved for' }} <strong data-cart-timer-out>{{ settings.checkout_timer_minutes | default: 10 }}:00</strong></span>
        </div>
      {%- endif -%}
      <form action="{{ routes.cart_url }}" method="post">
        {%- for item in cart.items -%}
          <div class="cart-line">
            <a class="cart-line__media" href="{{ item.url }}">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="100" height="125" loading="lazy">
              {%- endif -%}
            </a>
            <div>
              <p class="cart-line__title"><a href="{{ item.url }}">{{ item.product.title }}</a></p>
              {%- unless item.variant.title == 'Default Title' -%}
                <p class="cart-line__variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              <div class="cart-line__row">
                <div class="qty">
                  <label class="visually-hidden" for="qty-{{ forloop.index }}">Quantity</label>
                  <input
                    id="qty-{{ forloop.index }}"
                    style="width:56px;background:none;border:0;text-align:center;"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                  >
                </div>
                <span class="cart-line__price">{{ item.final_line_price | money }}</span>
              </div>
              <a class="cart-line__remove" href="{{ item.url_to_remove }}">Remove</a>
            </div>
          </div>
        {%- endfor -%}
        <div class="cart-page__foot">
          <p class="cart-drawer__subtotal-price" style="margin-bottom:8px;">Subtotal: {{ cart.total_price | money }}</p>
          <p class="cart-drawer__note">Shipping &amp; taxes calculated at checkout.</p>
          <div style="display:inline-flex; gap:10px;">
            <button class="btn btn--ghost" type="submit" name="update">Update</button>
            <button class="btn btn--primary" type="submit" name="checkout">Checkout</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart page",
  "settings": []
}
{% endschema %}
