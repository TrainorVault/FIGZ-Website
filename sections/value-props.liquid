<section class="section" style="border-block: 1px solid var(--c-border); background: var(--c-surface);">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-head reveal" style="justify-content:center; text-align:center;">
        <div>
          {%- if section.settings.overline != blank -%}
            <span class="overline">{{ section.settings.overline }}</span>
          {%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}
    <div class="value-props">
      {%- for block in section.blocks -%}
        <div class="value-prop reveal" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value props",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline", "default": "The Model" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built different" }
  ],
  "blocks": [
    {
      "type": "prop",
      "name": "Value prop",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "medal", "label": "Medal" },
            { "value": "shield", "label": "Shield" },
            { "value": "globe", "label": "Globe" },
            { "value": "truck", "label": "Truck" },
            { "value": "star", "label": "Star" },
            { "value": "check", "label": "Check" }
          ],
          "default": "medal"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Limited worldwide" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Every release is capped. Once a volume sells out, it never returns." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value props",
      "blocks": [
        { "type": "prop", "settings": { "icon": "medal", "heading": "Limited worldwide", "text": "Every release is capped. Once a volume sells out, it never returns." } },
        { "type": "prop", "settings": { "icon": "star", "heading": "Riders get paid", "text": "Athletes earn royalties on every FIGZ sale, worldwide. Collecting supports the culture." } },
        { "type": "prop", "settings": { "icon": "shield", "heading": "Authenticity guaranteed", "text": "Numbered editions, official artwork and verified signatures on signed releases." } }
      ]
    }
  ]
}
{% endschema %}
