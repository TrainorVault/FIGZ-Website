{%- liquid
  assign header_logo = section.settings.logo | default: settings.logo
  assign header_logo_width = section.settings.logo_width | default: settings.logo_width
-%}
<header class="site-header" style="--logo-width: {{ header_logo_width }}px;">
  <div class="container site-header__top">
    <div class="site-header__left">
      <button class="header-icon-btn site-header__burger" type="button" data-drawer-open="MobileMenu" aria-label="Open menu">
        {% render 'icon', name: 'burger' %}
      </button>
      <div class="site-header__socials">
        {%- if settings.social_facebook != blank -%}
          <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
        {%- endif -%}
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
        {%- endif -%}
        {%- if settings.social_tiktok != blank -%}
          <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
        {%- endif -%}
      </div>
    </div>

    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} — home">
      {%- if header_logo -%}
        <img
          src="{{ header_logo | image_url: width: 600 }}"
          alt="{{ shop.name }}"
          width="{{ header_logo_width }}"
          height="{{ header_logo_width | divided_by: header_logo.aspect_ratio | round }}"
        >
      {%- else -%}
        <span>{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="site-header__actions">
      <a class="site-header__login" href="{{ routes.account_url }}">
        {%- if customer -%}My Account{%- else -%}Login / Register{%- endif -%}
      </a>
      <a class="header-icon-btn" href="{{ routes.search_url }}" aria-label="Search">
        {% render 'icon', name: 'search' %}
      </a>
      <a class="header-icon-btn header-icon-btn--wishlist" href="{{ routes.root_url }}pages/wishlist" aria-label="My Collection" data-wishlist-link>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 20.6 4.1 12.7A4.7 4.7 0 0 1 10.8 6l1.2 1.2L13.2 6a4.7 4.7 0 0 1 6.7 6.7L12 20.6Z"/></svg>
        <span class="cart-count wishlist-count" data-wishlist-count data-count="0" aria-hidden="true" hidden>0</span>
      </a>
      <button class="header-icon-btn" type="button" data-drawer-open="CartDrawer" aria-label="Cart ({{ cart.item_count }} items)">
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  <nav class="site-header__navrow" aria-label="Main">
    <a class="site-header__home" href="{{ routes.root_url }}" aria-label="Home">{% render 'icon', name: 'home' %}</a>
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
    {%- comment -%}
      Theme-scoped nav item: menus are store-wide, so a link that should exist
      only where this theme is running (e.g. My Collection while it previews on
      a draft) lives here instead of in the shared menu.
    {%- endcomment -%}
    {%- if section.settings.nav_extra_label != blank and section.settings.nav_extra_link != blank -%}
      <a href="{{ section.settings.nav_extra_link }}" {% if request.path == section.settings.nav_extra_link %}aria-current="page"{% endif %}>{{ section.settings.nav_extra_label }}</a>
    {%- endif -%}
  </nav>
</header>

{%- comment -%} Mobile menu drawer {%- endcomment -%}
<div class="drawer" id="MobileMenu" aria-hidden="true" role="dialog" aria-label="Menu">
  <div class="drawer__overlay"></div>
  <div class="drawer__panel drawer__panel--left">
    <div class="drawer__head">
      <span class="drawer__title">Menu</span>
      <button class="drawer__close" type="button" data-drawer-close aria-label="Close menu">
        {% render 'icon', name: 'close' %}
      </button>
    </div>
    <div class="drawer__body">
      {%- if section.settings.drop_title != blank and section.settings.drop_link != blank -%}
        <a class="mobile-nav__drop" href="{{ section.settings.drop_link }}">
          <span class="overline">
            {%- if section.settings.drop_live -%}<span class="live-dot"></span>{%- endif -%}
            {{ section.settings.drop_title }}
          </span>
        </a>
      {%- endif -%}
      <nav class="mobile-nav" aria-label="Mobile">
        {%- for link in section.settings.menu.links -%}
          <a class="mobile-nav__link" href="{{ link.url }}">{{ link.title }}</a>
          {%- if link.links.size > 0 -%}
            <div class="mobile-nav__sub">
              {%- for child in link.links -%}
                <a href="{{ child.url }}">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.settings.nav_extra_label != blank and section.settings.nav_extra_link != blank -%}
          <a class="mobile-nav__link" href="{{ section.settings.nav_extra_link }}">{{ section.settings.nav_extra_label }}</a>
        {%- endif -%}
      </nav>
      <div class="mobile-nav__meta">
        <a href="{{ routes.account_url }}">Account</a>
        <a href="{{ routes.search_url }}">Search</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Header logo",
      "info": "Overrides the logo from Theme settings, for the header only. Leave empty to use the global logo."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 140
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Extra nav link"
    },
    {
      "type": "text",
      "id": "nav_extra_label",
      "label": "Label",
      "info": "Appended after the menu items. Lives in the theme rather than the shared menu, so it only appears where this theme runs — useful for pages that shouldn't be linked from the live theme yet."
    },
    {
      "type": "url",
      "id": "nav_extra_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Mobile menu drop banner"
    },
    {
      "type": "text",
      "id": "drop_title",
      "label": "Drop label",
      "default": "VOL. 1 — LIVE NOW"
    },
    {
      "type": "url",
      "id": "drop_link",
      "label": "Drop link"
    },
    {
      "type": "checkbox",
      "id": "drop_live",
      "label": "Show live pulse dot",
      "default": true
    }
  ]
}
{% endschema %}
