<section class="section" id="athletes">
  <div class="container">
    <div class="section-head reveal">
      <div>
        {%- if section.settings.overline != blank -%}
          <span class="overline">{{ section.settings.overline }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link != blank -%}
        <a class="link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label | default: 'Meet the team' }}</a>
      {%- endif -%}
    </div>
    <div class="rail">
      {%- for block in section.blocks -%}
        {%- assign card_tag = 'div' -%}
        {%- if block.settings.link != blank -%}{%- assign card_tag = 'a' -%}{%- endif -%}
        <{{ card_tag }} {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} class="rider-card reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            <img
              src="{{ block.settings.image | image_url: width: 600 }}"
              srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w"
              sizes="(min-width: 1200px) 25vw, (min-width: 750px) 40vw, 78vw"
              alt="{{ block.settings.name | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          {%- endif -%}
          <div class="rider-card__overlay">
            <p class="rider-card__name">{{ block.settings.name }}</p>
            {%- if block.settings.discipline != blank -%}
              <p class="rider-card__meta">{{ block.settings.discipline }}</p>
            {%- endif -%}
          </div>
        </{{ card_tag }}>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Riders",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline", "default": "The Team" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Riders to Watch" },
    { "type": "url", "id": "link", "label": "See-all link" },
    { "type": "text", "id": "link_label", "label": "See-all label", "default": "Meet the team" }
  ],
  "blocks": [
    {
      "type": "rider",
      "name": "Rider",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Portrait 3:4 works best" },
        { "type": "text", "id": "name", "label": "Name", "default": "Ryan Williams" },
        { "type": "text", "id": "discipline", "label": "Discipline", "default": "Scooter / BMX" },
        { "type": "url", "id": "link", "label": "Link (profile page or their products)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Riders",
      "blocks": [
        { "type": "rider" },
        { "type": "rider", "settings": { "name": "Rider Two", "discipline": "Scooter" } },
        { "type": "rider", "settings": { "name": "Rider Three", "discipline": "Scooter" } },
        { "type": "rider", "settings": { "name": "Rider Four", "discipline": "BMX" } }
      ]
    }
  ]
}
{% endschema %}
