<div class="container section">
  <header class="collection-head reveal" style="padding-top:0;">
    <span class="overline">Collect Culture™</span>
    <h1>{{ blog.title }}</h1>
  </header>
  {%- paginate blog.articles by 9 -%}
    <div class="editorial-grid">
      {%- for article in blog.articles -%}
        <article class="editorial-card reveal">
          <div class="editorial-card__media">
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 700 }}"
                alt="{{ article.image.alt | default: article.title | escape }}"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
                loading="lazy"
              >
            {%- endif -%}
          </div>
          <p class="editorial-card__date">{{ article.published_at | date: '%d %b %Y' }}</p>
          <h2 class="editorial-card__title h3"><a href="{{ article.url }}">{{ article.title }}</a></h2>
        </article>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
