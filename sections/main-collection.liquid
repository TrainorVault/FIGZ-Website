<div class="container">
  <header class="collection-head reveal">
    {%- if collection.metafields.figz.overline != blank -%}
      <span class="overline">{{ collection.metafields.figz.overline }}</span>
    {%- endif -%}
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p>{{ collection.description | strip_html }}</p>
    {%- endif -%}
  </header>

  {%- paginate collection.products by section.settings.per_page -%}
    <div class="collection-toolbar">
      <span class="collection-toolbar__count">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</span>
      <form id="SortForm">
        <label class="visually-hidden" for="SortBy">Sort by</label>
        <select
          id="SortBy"
          name="sort_by"
          onchange="const u = new URL(location.href); u.searchParams.set('sort_by', this.value); location.href = u;"
        >
          {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>

    {%- if collection.products.size == 0 -%}
      <div class="empty-state">
        <h2>Nothing here yet</h2>
        <p>New drops are always coming. Join the list to hear first.</p>
        <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">Shop All</a>
      </div>
    {%- else -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">‹</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="current" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span>{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">›</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "min": 8, "max": 24, "step": 4, "label": "Products per page", "default": 16 },
    { "type": "paragraph", "content": "Install the free 'Shopify Search & Discovery' app to add faceted filters (price, availability, rider) to this page." }
  ]
}
{% endschema %}
