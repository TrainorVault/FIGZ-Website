<span class="overline" style="display:block; margin-bottom:16px;">The next drop is coming</span>
<h1>{{ shop.name }}</h1>
<p>{{ shop.password_message | default: "We're building something for collectors. Back soon." }}</p>
{%- form 'storefront_password' -%}
  {%- if form.errors -%}
    <p style="color:#FF3B3B; margin-bottom:12px;">Wrong password — try again.</p>
  {%- endif -%}
  <input type="password" name="password" placeholder="Password" aria-label="Password" required>
  <button type="submit">Enter</button>
{%- endform -%}
