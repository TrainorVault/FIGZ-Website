<div class="container">
  <div class="form-card">
    <h1>Log In</h1>
    <p>Access your orders and collection.</p>
    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field">
        <label for="CustomerEmail">Email</label>
        <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="CustomerPassword">Password</label>
        <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
      </div>
      <button class="btn btn--primary btn--full" type="submit">Log In</button>
      <div class="form-links">
        <a href="#recover" onclick="document.getElementById('RecoverForm').style.display='block'; this.closest('.form-links').style.display='none'; return false;">Forgot your password?</a>
        <span>New here? <a href="{{ routes.account_register_url }}">Create an account</a></span>
      </div>
    {%- endform -%}

    <div id="RecoverForm" style="display:{% if form.posted_successfully? %}block{% else %}none{% endif %}; margin-top:32px;">
      <h2 class="h3" style="margin-bottom:16px;">Reset Password</h2>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <p class="newsletter__success">Check your email for a reset link.</p>
        {%- else -%}
          <div class="field">
            <label for="RecoverEmail">Email</label>
            <input type="email" id="RecoverEmail" name="email" autocomplete="email" required>
          </div>
          <button class="btn btn--ghost btn--full" type="submit">Send Reset Link</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>
