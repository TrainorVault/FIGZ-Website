<div class="container section">
  <div class="page-narrow">
    <a class="link-arrow" href="{{ routes.account_url }}" style="display:inline-block; margin-bottom:20px;">Back to account</a>
    <h1 class="h2" style="margin-bottom:24px;">Addresses</h1>

    {%- paginate customer.addresses by 10 -%}
      {%- for address in customer.addresses -%}
        <div style="border:1px solid var(--c-border); border-radius:10px; padding:20px; margin-bottom:16px;">
          {%- if address == customer.default_address -%}
            <span class="badge badge--signed" style="margin-bottom:10px;">Default</span>
          {%- endif -%}
          <p>{{ address.first_name }} {{ address.last_name }}</p>
          <p class="text-muted text-small">{{ address | format_address }}</p>
          <div style="margin-top:12px; display:flex; gap:14px;">
            {{ address | edit_customer_address_link: 'Edit' }}
            {{ address | delete_customer_address_link: 'Delete' }}
          </div>
        </div>
      {%- endfor -%}
    {%- endpaginate -%}

    <h2 class="h3" style="margin-block:28px 16px;">Add a new address</h2>
    {%- form 'customer_address', customer.new_address -%}
      <div class="field"><label for="AddrFirst">First name</label><input type="text" id="AddrFirst" name="address[first_name]" autocomplete="given-name"></div>
      <div class="field"><label for="AddrLast">Last name</label><input type="text" id="AddrLast" name="address[last_name]" autocomplete="family-name"></div>
      <div class="field"><label for="AddrAddress1">Address</label><input type="text" id="AddrAddress1" name="address[address1]" autocomplete="address-line1"></div>
      <div class="field"><label for="AddrAddress2">Apartment, suite, etc.</label><input type="text" id="AddrAddress2" name="address[address2]" autocomplete="address-line2"></div>
      <div class="field"><label for="AddrCity">City</label><input type="text" id="AddrCity" name="address[city]" autocomplete="address-level2"></div>
      <div class="field">
        <label for="AddrCountry">Country</label>
        <select id="AddrCountry" name="address[country]" data-default="{{ customer.new_address.country }}">
          {{ all_country_option_tags }}
        </select>
      </div>
      <div class="field"><label for="AddrZip">Postcode</label><input type="text" id="AddrZip" name="address[zip]" autocomplete="postal-code"></div>
      <div class="field"><label for="AddrPhone">Phone</label><input type="tel" id="AddrPhone" name="address[phone]" autocomplete="tel"></div>
      <label style="display:flex; align-items:center; gap:8px; margin-bottom:16px; font-size:0.9rem;">
        <input type="checkbox" name="address[default]"> Set as default address
      </label>
      <button class="btn btn--primary" type="submit">Add Address</button>
    {%- endform -%}
  </div>
</div>
