<div class="container section">
  <div class="page-narrow">
    <a class="link-arrow" href="{{ routes.account_url }}" style="display:inline-block; margin-bottom:20px;">Back to account</a>
    <h1 class="h2">Order {{ order.name }}</h1>
    <p class="article-meta">{{ order.created_at | date: '%d %B %Y' }} · {{ order.fulfillment_status_label }}</p>

    <table class="data-table" style="margin-block:24px;">
      <thead>
        <tr><th>Item</th><th>Qty</th><th>Total</th></tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>
              {{ line_item.title }}
              {%- if line_item.fulfillment.tracking_url -%}
                <br><a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" rel="noopener">Track shipment</a>
              {%- endif -%}
            </td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>

    <div style="text-align:right; color: var(--c-muted); font-size: 0.9rem;">
      <p>Subtotal: {{ order.line_items_subtotal_price | money }}</p>
      {%- for shipping_method in order.shipping_methods -%}
        <p>Shipping ({{ shipping_method.title }}): {{ shipping_method.price | money }}</p>
      {%- endfor -%}
      <p style="color: var(--c-text); font-weight: 700; font-size: 1.05rem;">Total: {{ order.total_price | money }}</p>
    </div>
  </div>
</div>
